RUST_MIN_VER="1.85.0"

inherit cargo systemd

DESCRIPTION="Secure IMAP/SMTP/EWS/Graph API MCP server in Rust"
HOMEPAGE="https://github.com/tecnologicachile/mail-mcp https://mail-mcp.tecnologicachile.cl/"
SRC_URI="
	https://github.com/tecnologicachile/mail-mcp/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+=" 0BSD Apache-2.0 BSD BSD-2 CC0-1.0 ISC MIT MPL-2.0 Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64"

BDEPEND="
	dev-build/cmake
"

DOCS=(
	AGENTS.md
	CONTRIBUTING.md
	README.md
)

src_install() {
	cargo_src_install

	systemd_dounit "${FILESDIR}/mail-mcp.service"

	insinto /etc/mail-mcp
	newins .env.example mail-mcp.env.example

	dodoc "${DOCS[@]}"
}
