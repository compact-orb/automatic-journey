CFLAGS="${CFLAGS} -march=x86-64-v3 -maes -mpclmul"
CXXFLAGS="${CXXFLAGS} -march=x86-64-v3 -maes -mpclmul"

FFLAGS="${FFLAGS} -march=x86-64-v3 -maes -mpclmul"
FCFLAGS="${FCFLAGS} -march=x86-64-v3 -maes -mpclmul"

RUSTFLAGS="${RUSTFLAGS} --codegen target-cpu=x86-64-v3 --codegen target-feature=+aes,+pclmulqdq"
GOAMD64="v3"

KCFLAGS="${KCFLAGS} -march=x86-64-v3 -maes -mpclmul"
