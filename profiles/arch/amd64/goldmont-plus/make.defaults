FFLAGS="${FFLAGS} -march=goldmont-plus"
FCFLAGS="${FCFLAGS} -march=goldmont-plus"

RUSTFLAGS="${RUSTFLAGS} --codegen target-cpu=goldmont-plus"
GOAMD64="v2"

KCFLAGS="${KCFLAGS} -march=goldmont-plus"

CPU_FLAGS_X86="aes mmx mmxext pclmul popcnt rdrand sha sse sse2 sse3 sse4_1 sse4_2 ssse3"
VIDEO_CARDS="-* intel"
