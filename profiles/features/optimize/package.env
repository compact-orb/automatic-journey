# Parallel install race condition (Gentoo bug #654130 / #975876)
media-libs/clutter-gst j1.conf

# Avoid LLVM ThinLTO crash on non-AVX targets
media-video/ffmpeg full-lto.conf

# Allow K&R C syntax under Clang (Gentoo bug #972356)
net-misc/telnet-bsd gnu17.conf

# llvm-objcopy does not support efi-app-* targets
sys-apps/fwupd-efi gnu-objcopy.conf

# Embedded rawspeed uses -fwhole-program-vtables; requires split LTO units
media-gfx/darktable split-lto-unit.conf

# Polly causes exponential compile times on complex loop nests
media-libs/opencv no-polly.conf

# Parallel valac race in ui/gtk3/Makefile.am generating same C sources
app-i18n/ibus j1.conf
