CFLAGS="-O3 -pipe -fdata-sections -ffunction-sections -fno-plt -fno-semantic-interposition -fno-math-errno -ffp-contract=fast -fno-asynchronous-unwind-tables -flto=thin -Xclang=-mllvm -Xclang=-polly -Xclang=-mllvm -Xclang=-polly-vectorizer=stripmine -Xclang=-mllvm -Xclang=-polly-invariant-load-hoisting"
CXXFLAGS="${CFLAGS}"

FFLAGS="-O3 -pipe -fdata-sections -ffunction-sections -fno-plt -fno-semantic-interposition -fno-math-errno -fno-trapping-math -fno-asynchronous-unwind-tables -flto"
FCFLAGS="${FFLAGS}"

LDFLAGS="${LDFLAGS} -fuse-ld=lld -Wl,--gc-sections -Wl,--undefined-version -flto=thin -Wl,--lto-O3"

RUSTFLAGS="--codegen linker-plugin-lto"
CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="clang"
CARGO_HOST_LINKER="clang"

CGO_CFLAGS="${CFLAGS}"
CGO_CXXFLAGS="${CXXFLAGS}"
CGO_FFLAGS="${FFLAGS}"
CGO_LDFLAGS="${LDFLAGS}"

LLVM="1"
KCFLAGS="-O3 -pipe -fno-asynchronous-unwind-tables -mllvm -polly -mllvm -polly-vectorizer=stripmine -mllvm -polly-invariant-load-hoisting"

USE="${USE} apparmor dist-kernel jemalloc jit ktls lto modules-sign orc pgo profile secureboot tpm"

EMERGE_DEFAULT_OPTS="--getbinpkgonly --with-bdeps=n"

FEATURES="binpkg-request-signature"

FETCHCOMMAND="/usr/bin/aria2c --dir=\"\${DISTDIR}\" --file-allocation=none --max-concurrent-downloads=4 --max-connection-per-server=4 --max-tries=3 --out=\"\${FILE}\" --split=4 \"\${URI}\""
RESUMECOMMAND="/usr/bin/aria2c --continue=true --dir=\"\${DISTDIR}\" --file-allocation=none --max-concurrent-downloads=4 --max-connection-per-server=4 --max-tries=3 --out=\"\${FILE}\" --split=4 \"\${URI}\""

ACCEPT_LICENSE="*"

GENTOO_MIRRORS="http://gentoo.mirrors.ovh.net/gentoo-distfiles http://mirror.planetunix.net/pub/gentoo http://distfiles.gentoo.org"
