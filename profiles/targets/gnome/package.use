# Avoid circular dependencies
dev-python/pillow -truetype
gnome-base/gnome-keyring -ssh-agent
media-libs/libavif -gdk-pixbuf

# Disable obsolete bogofilter plugin in Evolution
mail-client/evolution -bogofilter

# Desktops do not need gpm, which pulls in 32-bit multilib
sys-libs/ncurses -gpm

# Required by net-fs/samba for SMB-over-QUIC
net-libs/ngtcp2 gnutls
